{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".postgres-spec.ts$",
  "testTimeout": 30000,
  "setupFilesAfterEnv": [
    "<rootDir>/postgres/setup.ts"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "allowJs": true,
          "module": "ESNext",
          "moduleResolution": "bundler"
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules"
  ],
  "extensionsToTreatAsEsm": [
    ".ts"
  ]
}
